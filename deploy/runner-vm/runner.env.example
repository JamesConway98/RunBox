# /etc/runbox/runner.env — root:runbox 0640. Never commit the filled-in copy.

# Railway gives you these on the Postgres and Redis services. Use the *public*
# connection strings: the runner is outside Railway's private network, so the
# .railway.internal hostnames will not resolve from this box.
DATABASE_URL=postgresql://postgres:...@maglev.proxy.rlwy.net:PORT/railway
REDIS_URL=redis://default:...@maglev.proxy.rlwy.net:PORT

# Held only here. The control plane never needs it — it does not call a model.
ANTHROPIC_API_KEY=
# Optional. Unset means gpt-* runs fail with a clear 403 from our own proxy
# rather than a confusing 401 from OpenAI.
OPENAI_API_KEY=

# Pin by digest, never a tag. "Which code actually ran" is the first question
# asked about any agent trace, and a tag cannot answer it.
RUNBOX_AGENT_IMAGE=ghcr.io/jamesconway98/runbox-agent@sha256:REPLACE_ME

RUNBOX_WORKERS=4
RUNBOX_MEMORY_MB=512
RUNBOX_CPUS=1.0
RUNBOX_PIDS_LIMIT=128
RUNBOX_MAX_TIMEOUT=600s
RUNBOX_LOG_LEVEL=info

# Must match ReadWritePaths in the systemd unit and the tmpfiles.d entry.
RUNBOX_SOCKET_DIR=/var/run/runbox-sockets

# Hosts the http_get tool may reach. Everything else is refused by the proxy.
RUNBOX_EGRESS_ALLOWLIST=api.github.com,raw.githubusercontent.com,en.wikipedia.org
