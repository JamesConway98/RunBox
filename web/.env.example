# The control plane. Requests are proxied through src/app/api/[...path]/route.ts
# so the browser stays on one origin and EventSource works without CORS
# preflight.
RUNBOX_API_URL=http://localhost:8000

# The tenant API key the dashboard authenticates with. Every control-plane
# endpoint requires one, and the proxy attaches it server-side — deliberately
# not NEXT_PUBLIC_, so it is never shipped to the browser.
#
# Mint one with `python scripts/seed.py` (development) or
# `python scripts/mint_key.py <tenant-slug>` (anywhere else).
RUNBOX_API_KEY=

# Product analytics. Unset means every track() call is a no-op — local
# development and forks send nothing.
NEXT_PUBLIC_AMPLITUDE_API_KEY=
NEXT_PUBLIC_APP_VERSION=dev
