# Copy to .env and fill in. Never commit the real thing.

DATABASE_URL=postgresql://runbox:runbox@localhost:5432/runbox
REDIS_URL=redis://localhost:6379/0

# Held by the runner, injected into the sandbox. The agent never receives this
# from an API caller.
ANTHROPIC_API_KEY=

# Pin by digest in anything that is not a laptop.
RUNBOX_AGENT_IMAGE=runbox/agent:dev
RUNBOX_WORKERS=4
RUNBOX_MEMORY_MB=512
RUNBOX_CPUS=1.0

CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
